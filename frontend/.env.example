# Frontend – copy to .env and adjust. Do not commit .env.
# Only REACT_APP_* and PORT are used by Create React App.

PORT=5174
REACT_APP_API_URL=http://localhost:4001
# For prod: REACT_APP_API_URL=https://chatbot.cloudextel.com

REACT_APP_AZURE_CLIENT_ID=your_azure_client_id
REACT_APP_AZURE_TENANT_ID=your_azure_tenant_id
