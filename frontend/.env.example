# Frontend (Next.js) – copy to .env and adjust. Do not commit .env.
# For production: comment the LOCAL section and uncomment the PRODUCTION section.

# Azure AD (Web app; same app as CE_DF_Photos)
AZURE_AD_CLIENT_ID=your_azure_client_id
AZURE_AD_CLIENT_SECRET=your_azure_client_secret
AZURE_AD_TENANT_ID=your_azure_tenant_id
ALLOWED_DOMAIN=cloudextel.com

# ========== LOCAL (comment out when using PRODUCTION below) ==========
PORT=5174
NEXTAUTH_URL=http://localhost:5174
NEXTAUTH_SECRET=any_random_string_for_local
BACKEND_URL=http://127.0.0.1:4001
# Leave empty for local dev (uses dev-secret; backend accepts from localhost)
INTERNAL_PROXY_SECRET=

# ========== PRODUCTION (uncomment when deploying to production) ==========
# PORT=5174
# NEXTAUTH_URL=https://policy-assistant.cloudextel.com
# NEXTAUTH_SECRET=your_secure_random_secret_here
# BACKEND_URL=http://127.0.0.1:4001
# Same value as backend .env INTERNAL_PROXY_SECRET
# INTERNAL_PROXY_SECRET=your_shared_secret_here
