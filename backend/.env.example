# Backend – copy to .env and fill in. Do not commit .env.

FLASK_ENV=development
FLASK_APP=app.py
PORT=4001

# Required for chat/RAG
GOOGLE_API_KEY=your_google_api_key_here

# Microsoft Azure AD (org-only login; same app as CE_DF_Photos)
AZURE_AD_CLIENT_ID=your_azure_client_id
AZURE_AD_TENANT_ID=your_azure_tenant_id
# AZURE_AD_CLIENT_SECRET=optional_server_side_only
ALLOWED_DOMAIN=cloudextel.com

# Optional: base URL for "View source" PDF links
# BASE_URL=http://localhost:4001
# For prod: BASE_URL=https://chatbot.cloudextel.com
