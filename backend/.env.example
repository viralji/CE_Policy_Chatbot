# Backend – copy to .env and fill in. Do not commit .env.
# For production: comment the LOCAL section and uncomment the PRODUCTION section.

FLASK_APP=app.py
PORT=4001

# Required for chat/RAG
GOOGLE_API_KEY=your_google_api_key_here
# Optional: use models/text-embedding-004 (default) or models/gemini-embedding-001. If 500 errors, try the other.
# EMBEDDING_MODEL=models/text-embedding-004

# Microsoft Azure AD (org-only login; same app as CE_DF_Photos)
AZURE_AD_CLIENT_ID=your_azure_client_id
AZURE_AD_TENANT_ID=your_azure_tenant_id
AZURE_AD_CLIENT_SECRET=your_azure_client_secret
ALLOWED_DOMAIN=cloudextel.com

# ========== LOCAL (comment out when using PRODUCTION below) ==========
FLASK_ENV=development
BASE_URL=http://localhost:4001
# Leave empty for local dev (backend accepts dev-secret from localhost)
INTERNAL_PROXY_SECRET=

# ========== PRODUCTION (uncomment when deploying to production) ==========
# FLASK_ENV=production
# BASE_URL=https://chatbot.cloudextel.com
# Same value as frontend .env INTERNAL_PROXY_SECRET
# INTERNAL_PROXY_SECRET=your_shared_secret_here
